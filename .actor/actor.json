{
  "actorSpecification": 1,
  "name": "domain-history-contact-osint",
  "title": "Domain History Contact OSINT - WHOIS, DNS + Wayback Emails",
  "version": "1.0",
  "buildTag": "latest",
  "description": "Submit a domain, get its full history and owner contacts with a source URL on every finding. Works on dead, expired and parked domains by reading web archives, certificate transparency, RDAP and passive DNS.",
  "categories": ["SECURITY", "DEVELOPER_TOOLS"],
  "dockerfile": "./Dockerfile",
  "readme": "../README.md",
  "input": "./INPUT_SCHEMA.json",
  "output": "./output_schema.json",
  "minMemoryMbytes": 2048,
  "storages": {
    "datasets": {
      "default": {
        "actorSpecification": 1,
        "title": "Domain Reports",
        "description": "One row per domain. Always populated, even for a fully dead domain. Contains a status block, results sectioned by checkbox, and a per-section coverage report.",
        "views": {
          "overview": {
            "title": "Overview",
            "transformation": {
              "fields": [
                "domain",
                "status",
                "youAskedFor",
                "coverage",
                "scannedAt",
                "durationMs"
              ]
            },
            "display": {
              "component": "table",
              "properties": {
                "domain": { "label": "Domain", "format": "text" },
                "status": { "label": "Status", "format": "object" },
                "youAskedFor": { "label": "Sections", "format": "array" },
                "coverage": { "label": "Coverage", "format": "object" },
                "scannedAt": { "label": "Scanned", "format": "date" },
                "durationMs": { "label": "Duration (ms)", "format": "number" }
              }
            }
          },
          "coverage": {
            "title": "Source Coverage",
            "transformation": { "fields": ["domain", "sourcesDetail"] },
            "display": {
              "component": "table",
              "properties": {
                "domain": { "label": "Domain", "format": "text" },
                "sourcesDetail": { "label": "Per-source Result", "format": "object" }
              }
            }
          }
        }
      },
      "contacts": {
        "actorSpecification": 1,
        "title": "Contacts With Provenance",
        "description": "One row per contact per source. Every row carries the exact source URL, snapshot timestamp and extraction method that produced it.",
        "views": {
          "contacts": {
            "title": "Contacts",
            "transformation": {
              "fields": [
                "domain",
                "type",
                "value",
                "confidence",
                "sourceType",
                "sourceUrl",
                "snapshotTimestamp",
                "extractionMethod",
                "occurrences"
              ]
            },
            "display": {
              "component": "table",
              "properties": {
                "domain": { "label": "Domain", "format": "text" },
                "type": { "label": "Type", "format": "text" },
                "value": { "label": "Value", "format": "text" },
                "confidence": { "label": "Confidence", "format": "text" },
                "sourceType": { "label": "Source", "format": "text" },
                "sourceUrl": { "label": "Source URL", "format": "link" },
                "snapshotTimestamp": { "label": "Captured", "format": "text" },
                "extractionMethod": { "label": "Method", "format": "text" },
                "occurrences": { "label": "Seen", "format": "number" }
              }
            }
          }
        }
      }
    }
  }
}
